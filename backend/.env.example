# Database Configuration
DATABASE_URL=sqlite:///./fresh.db

# CORS Configuration
CORS_ORIGINS=http://localhost:5173

# Environment
ENVIRONMENT=development

# JWT Secret Key (change for production)
SECRET_KEY=fresh-secret-key-2024

# OpenRouter API (for AI recommendations in Food Scanner)
# If not set, scanner will use food_metadata.json fallback
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Railway deployment configuration:
# DATABASE_URL=postgresql://username:password@host:port/database
# CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
# ENVIRONMENT=production
# SECRET_KEY=your-production-secret-key
